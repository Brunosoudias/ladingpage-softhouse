# ═══════════════════════════════════════════════════════════════
# SoftHouse — Variáveis de ambiente para produção
# Copie para .env.local (dev) e configure no painel da Vercel (prod)
# ═══════════════════════════════════════════════════════════════

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://softhouse.dev
NEXT_PUBLIC_SITE_NAME=SoftHouse
NEXT_PUBLIC_SITE_TAGLINE=Software sob medida para negócios que querem evoluir.
NEXT_PUBLIC_CONTACT_EMAIL=contato@softhouse.dev
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# ── Redes sociais (opcional — oculta ícones se vazio) ─────────
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/seuusuario
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/seuusuario
NEXT_PUBLIC_GITHUB_URL=https://github.com/seuusuario

# ── E-mail — formulário de contato (Resend) ───────────────────
# https://resend.com → API Keys + verificar domínio
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=SoftHouse <contato@seudominio.com.br>
CONTACT_EMAIL=seu@email.com

# ── WhatsApp — notificação no seu celular (opcional) ──────────
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_NOTIFY_PHONE=5511999999999
CALLMEBOT_API_KEY=123456

# ═══════════════════════════════════════════════════════════════
# CHECKLIST ANTES DO DEPLOY
# ═══════════════════════════════════════════════════════════════
# [ ] Variáveis acima configuradas na Vercel
# [ ] Resend: domínio verificado + CONTACT_EMAIL correto
# [ ] Projetos adicionados em src/data/projects.ts (published: true)
# [ ] Screenshots em public/projects/ (opcional)
# [ ] Domínio apontando para a Vercel (NEXT_PUBLIC_SITE_URL)
